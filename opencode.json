{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "G:\\games\\AIChat\\memory.jsonl"
      }
    }
  },
  "provider": {
    "Cherry-深度求索": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cherry-深度求索",
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY_深度求索}",
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        }
      }
    }
  }
}