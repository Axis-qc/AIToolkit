# 当前使用的 provider：deepseek / openai / anthropic
CHAT_PROVIDER=deepseek

# ── DeepSeek ──
DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o

# ── Anthropic ──
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-3.5-sonnet

# 预热白名单：PREHEAT_0, PREHEAT_1, ... 数字后缀，格式 path[:ext1,ext2,...]
PREHEAT_0=app/core/:*.py
PREHEAT_1=app/tools/:*.py
PREHEAT_2=app/api/:*.py

# 文件操作工具白名单（逗号分隔）
FILE_TOOL_WHITELIST=

# ── 手机负载监控 SSH 凭据（不填则手机监控无数据）──
PHONE_HOST=
PHONE_PORT=8022
PHONE_USER=
PHONE_PASS=
PHONE_POLL_INTERVAL=3.0